# Public origin, including scheme and port. Use your HTTPS origin in production.
BETTER_AUTH_URL=http://localhost:3000
# Optional: at least 32 random characters. If omitted, a secret is generated and
# persisted privately alongside the database. Never rotate it casually.
# BETTER_AUTH_SECRET=
# Optional local paths (web and worker must use the same data directory):
NARRATOR_DATA_DIR=data/private
NARRATOR_MODEL_DIR=models
# NARRATOR_PYTHON=/absolute/path/to/.venv/bin/python
# NARRATOR_FFMPEG=ffmpeg
